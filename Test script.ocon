# ==========================================
# OTHER
# ==========================================

sec "Other

echo "========================================
echo "Other
echo "========================================

echo [ add [ mod '5 [ sub '3 '2 ] ] '5 ]

echo "✅ + "✅

echo [ tostring *"✅,"✅,"✅ + *"✅,"✅,"✅ ]
allvars

echo [ tonum "3 ]



# ==========================================
# VARIABLE CLEANUP
# ==========================================

sec "cleanup

echo "========================================
echo "CLEANUP
echo "========================================

unlink "a
unlink "b
unlink "counter
unlink "x
unlink "y
unlink "if_test
unlink "i
unlink "even_test
unlink "odd_test
unlink "n
unlink "array_var

echo "ALL_VARIABLES_UNLINKED

# ==========================================
# FINAL
# ==========================================

sec "fin

echo "=================================
echo "ALL_TESTS_REACHED_END
echo "=================================