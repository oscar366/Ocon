!debugOFF
# ==========================================
# OCON TEST PROGRAM
# ==========================================

echo "=================================
echo "OCON_TEST_PROGRAM
echo "=================================


# ==========================================
# BASIC OUTPUT
# ==========================================

echo "=====_BASIC_OUTPUT_=====

echo "hello
echo "testing_123


# ==========================================
# VARIABLES
# ==========================================

echo "=====_VARIABLES_=====

var "a '10
var "b '3

echo $a
echo $b


# ==========================================
# BASIC ARITHMETIC
# ==========================================

echo "=====_ARITHMETIC_=====

echo [ add '10 '5 ]
echo [ sub '10 '5 ]
echo [ mlt '10 '5 ]
echo [ div '10 '5 ]

# Expected:
# 15
# 5
# 50
# 2


# ==========================================
# MODULO
# ==========================================

echo "=====_MODULO_=====

echo [ mod '10 '3 ]
echo [ mod '20 '4 ]
echo [ mod '17 '5 ]

# Expected:
# 1
# 0
# 2


# ==========================================
# INCREMENT / DECREMENT
# ==========================================

echo "=====_INCREMENT_/_DECREMENT_=====

var "counter '10

echo $counter

increment "counter '5
echo $counter

decremnt "counter '3
echo $counter

# Expected:
# 10
# 15
# 12


# ==========================================
# BOOLEAN FUNCTIONS
# ==========================================

echo "=====_BOOLEANS_=====

echo [ iseven '10 ]
echo [ iseven '11 ]

echo [ isodd '10 ]
echo [ isodd '11 ]

echo [ isless '5 '10 ]
echo [ isless '10 '5 ]

echo [ isgreater '10 '5 ]
echo [ isgreater '5 '10 ]

echo [ isequal '5 '5 ]
echo [ isequal '5 '10 ]


# ==========================================
# NOT
# ==========================================

echo "=====_NOT_=====

echo [ not ~true ]
echo [ not ~false ]


# ==========================================
# MATH FUNCTIONS
# ==========================================

echo "=====_MATH_=====

echo [ sin '0 ]
# 0

echo [ sin '1 ]
# 0.8414709848078965

echo [ cos '0 ]
# 1

echo [ cos '1 ]
# 0.5403023058681398

echo [ tan '0 ]
# 0

echo [ tan '1 ]
# 1.557407724654902

echo [ round '5 ]
# 5

echo [ round '10 ]
# 10

echo [ abs '10 ]
# 10

echo [ abs '-10 ]
# 10

echo [ log '1 ]
# 0

echo [ log '10 ]
# 2.302585092994046


# ==========================================
# EXPRESSIONS USING VARIABLES
# ==========================================

echo "=====_VARIABLES_IN_EXPRESSIONS_=====

var "x '20
var "y '7

echo [ add $x $y ]
echo [ sub $x $y ]
echo [ mlt $x $y ]
echo [ div $x $y ]
echo [ mod $x $y ]

# Expected:
# 27
# 13
# 140
# 2
# 6


# ==========================================
# IF TRUE
# ==========================================

echo "=====_IF_TRUE_=====

if ~true echo "IF_TRUE_WORKED else echo "ERROR_IF_TRUE_FAILED


# ==========================================
# IF FALSE
# ==========================================

echo "=====_IF_FALSE_=====

if ~false echo "ERROR_IF_FALSE_FAILED else echo "IF_FALSE_WORKED


# ==========================================
# IF WITHOUT ELSE
# ==========================================

echo "=====_IF_WITHOUT_ELSE_=====

if ~true echo "IF_WITHOUT_ELSE_WORKED

if ~false echo "ERROR_FALSE_IF_WITHOUT_ELSE


# ==========================================
# IF WITH BOOLEAN FUNCTIONS
# ==========================================

echo "=====_IF_BOOLEAN_FUNCTIONS_=====

if [ iseven '10 ] echo "10_IS_EVEN else echo "ERROR_10_IS_NOT_EVEN

if [ isodd '10 ] echo "ERROR_10_IS_ODD else echo "10_IS_NOT_ODD

if [ isgreater '10 '5 ] echo "10_GREATER_THAN_5 else echo "ERROR_GREATER_TEST_FAILED

if [ isless '5 '10 ] echo "5_LESS_THAN_10 else echo "ERROR_LESS_TEST_FAILED

if [ isequal '5 '5 ] echo "5_EQUALS_5 else echo "ERROR_EQUAL_TEST_FAILED


# ==========================================
# IF SETVAR
# ==========================================

echo "=====_IF_SETVAR_=====

if ~true setvar "if_test '123

echo $if_test


# ==========================================
# SIMPLE LOOP
# ==========================================

echo "=====_LOOP_TEST_=====

var "i '0

§ "loop

increment "i '1
echo $i

if [ isless $i '5 ] goto "loop else echo "LOOP_FINISHED


# ==========================================
# EVEN NUMBER TEST
# ==========================================

echo "=====_EVEN_NUMBER_TEST_=====

var "even_test '10

if [ iseven $even_test ] echo "FOUND_EVEN_NUMBER else echo "ERROR_EVEN_NUMBER_TEST_FAILED

var "odd_test '11

if [ iseven $odd_test ] echo "ERROR_ODD_NUMBER_DETECTED_AS_EVEN else echo "ODD_NUMBER_TEST_WORKED


# ==========================================
# LARGE NUMBER TEST
# ==========================================

echo "=====_LARGE_NUMBERS_=====

echo [ add '1000000 '2000000 ]
echo [ mlt '100000 '1000 ]

# Expected:
# 3000000
# 100000000


# ==========================================
# FUNCTIONS
# ==========================================

echo "==========================================
echo "FUNCTIONS
echo "==========================================

func "sayHi

var "n '0

sec "🐠

echo "🐟
increment "n '1

if [ isless $n '5 ] goto "🐠 else echo "FUNCTION_FINISHED

end @sayHi

@sayHi


# ==========================================
# ARRAYS
# ==========================================

echo "==========================================
echo "Arrays
echo "==========================================

echo *"❌,"❌,"✅|2

var "array_var *"❌,"❌,"✅
echo $array_var|2

echo "[ length *'1,"2,'32,"eeeee ]

echo "[ append *'1,'2,'3 *'4,'5,'6 ]
# *'1,'2,'3,'4,'5,'6

echo "[ prepend *'4,'5,'6 *'1,'2,'3 ]

echo "[ remove *"✅,"❌,"✅ '1 ]

echo [ contains *"a,"b,"c "a ]
echo [ contains *"a,"b,"c "d ]

echo [ indexOf *"a,"b,"c "b ]

echo "[ join *"a,"b,"c *"d,"e,"f ]

echo "Arrays_Done


# ==========================================
# FOR LOOP
# ==========================================

echo "========================================
echo "For_Loop
echo "========================================

var "n '0

for

increment "n '1
echo "✅

endfor [ < $n '5 ]




# ==========================================
# ERROR HANDLING
# ==========================================

sec "error_hadling

echo "========================================
echo "ERROR_HANDLING
echo "========================================

# echo with no arguments should produce an error
try "a echo

echo $a

try if ~true throwError "HI_THERE

echo "========================================
echo "RUN_AND_START
echo "========================================

sec "run_and_start
# run waits
# run "notepad.exe "Test script.ocon"
# start doesnt
# start "notepad.exe "Test script.ocon"

echo "Run_and_start_have_been_commeted_out_if_you_would_like_to_use_them_please_undo_the_comments




echo "========================================
echo "Easter_eggs
echo "========================================

# 🥚
echo "The_easter_egg_above_has_been_commented_out_uncomment_it_if_you_want_to_see_it

echo "========================================
echo "User_Input
echo "========================================

echo [ inputbool ~true ]

var "a [ inputnum ~true ]
echo [ concat $a "_+_ "2_= ]
echo [ add $a '2 ]

var "b [ inputchar ~true ]
echo $b
var "array_var *"a,"b,"c,"d
if [ contains $array_var $b ] echo "array_does_contain_your_char else echo "array_does_NOT_contain_your_char

